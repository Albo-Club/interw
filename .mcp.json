{
  "mcpServers": {
    "convex": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "convex@1.46.0",
        "mcp",
        "start",
        "--project-dir",
        "${CLAUDE_PROJECT_DIR:-.}"
      ],
      "env": {}
    },
    "spectrum-ui": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@spectrumui/mcp@0.1.1"
      ],
      "env": {
        "SPECTRUM_NO_TELEMETRY": "1"
      }
    }
  }
}
